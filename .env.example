# ============================================================
# 研修用の設定ファイル
#
# start.sh（Windows は start.bat）を実行すると、対話で作られます。
# ============================================================

# 講師から指定された場合のみ変更してください
GHCR_OWNER=kouichinoro
IMAGE_TAG=latest

# Claude Code が使うモデル（講師が当日切り替える場合があります）
#   claude-sonnet-5 … 既定。費用を抑えられる
#   claude-opus-5   … より賢いが、費用は約 2.5 倍
CLAUDE_MODEL=claude-sonnet-5

# 講師から配布されたキー（アプリの読み取りと Claude Code の両方で使います）
ANTHROPIC_API_KEY=
